{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "index.ts",
    "controllers",
    "routes",
    "middleware",
    "services",
    "types",
    "config",
    "utils",
    "prisma/seed.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
